{
  "compilerOptions": {
    "inlineSourceMap": true,
    "inlineSources": true,
    "module": "ESNext",
    "target": "ES2018",
    "allowSyntheticDefaultImports": true,
    "moduleResolution": "bundler",
    "strictNullChecks": true,
    "strictBindCallApply": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": [
      "ES2020",
      "DOM"
    ],
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "src/**/*.ts"
  ]
}
